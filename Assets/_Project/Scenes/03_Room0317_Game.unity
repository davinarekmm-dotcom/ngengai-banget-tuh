  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Room0317.Apartment.InteractablePoint
  pointName: Inspect_Mirror
  parentRoom: {fileID: 896154333}
  stateALines:
  - speaker: Adrian
    expression: Exhausted
    text: My own tired face in the clean bathroom mirror. Dark circles under my eyes.
      I can never sleep past 03:17.
  stateBLines:
  - speaker: Adrian
    expression: Scared
    text: THE MIRROR! It's covered in hot steam, and there is a wet handprint sliding
      down the inside of the glass!
  - speaker: Adrian
    expression: Scared
    text: The sink water isn't even running! And there are footprints on the tiles
      leading toward the door!
  triggerRadius: 2.48
