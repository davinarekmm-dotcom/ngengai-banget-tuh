--- !u!114 &1022259853
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1022259851}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aff95ee5174641148948915333825bb5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Room0317.Apartment.InteractablePoint
  pointName: Inspect_CoffeeTable
  parentRoom: {fileID: 130648123}
  stateALines:
  - speaker: Adrian
    expression: Neutral
    text: A framed photograph sits on the coffee table. Two people laughing in front
      of the window. I recognize myself on the left...
  - speaker: Adrian
    expression: Neutral
    text: Who is the other person? I don't remember taking this photo.
  stateBLines:
  - speaker: Adrian
    expression: Scared
    text: LOOK AT THE COFFEE TABLE! The photograph is gone! In its place is an old
      tarnished brass key!
  - speaker: Adrian
    expression: Scared
    text: And there's a jagged crack running down the wall behind the lamp! Who was
      in here?!
  triggerRadius: 1.8
