  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Room0317.Apartment.InteractablePoint
  pointName: Inspect_DiningTable
  parentRoom: {fileID: 874196722}
  stateALines:
  - speaker: Adrian
    expression: Neutral
    text: A wooden dining table with a potted fern and my single coffee mug from
      yesterday. Cold and untouched.
  stateBLines:
  - speaker: Adrian
    expression: Scared
    text: WHAT?! There are TWO coffee mugs on the dining table now! The second mug
      is steaming hot!
  - speaker: Adrian
    expression: Scared
    text: And look at the floor by the doorway... a dark, wet footprint! I live alone!
  triggerRadius: 1.8
