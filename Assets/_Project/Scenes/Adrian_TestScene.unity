MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2091711517}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ff23c8f97edd2e4d9c29e600ae953ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Room0317.Dialogue.DialogueTester
  dialogueBox: {fileID: 1691882495}
  adrian: {fileID: 586749648}
  playOnStart: 1
  lines:
  - speaker: Adrian
    expression: Neutral
    text: 03:17 again... Every single night, the same minute. My phone just buzzed,
      but there's no sender.
  - speaker: Adrian
    expression: Exhausted
    text: I haven't slept properly in weeks. Maybe I'm just tired. Maybe none of
      this is real.
  - speaker: Adrian
    expression: Scared
    text: Wait... that chair wasn't there a second ago. Somebody moved it. Somebody
      is in here.
  - speaker: Adrian
    expression: Nervous
    text: Okay. Breathe. Use WASD or the arrow keys to look around. Press T if you
      want to hear me panic again.
